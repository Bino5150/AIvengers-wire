{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${AIVENGERS_WIRE_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wire_notice.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AIVENGERS_WIRE_PYTHON:-python3}\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wire_notice.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
